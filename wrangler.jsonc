{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "soldo",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // La PWA è servita come static assets. Il Worker gestisce solo /api/* (token OAuth dalla Fase 3).
  // Nessun dato di spesa passa dal server.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
