{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "soldo",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The PWA is served as static assets. The Worker only handles /api/* (OAuth tokens from Phase 3).
  // No expense data ever goes through the server.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  // Required by `wrangler preview` (per-branch previews). Empty: no bindings or vars to keep apart
  // from production. When they arrive (e.g. OAuth secrets in Phase 3) repeat them here.
  "previews": {}
}
