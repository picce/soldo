{
  "name": "soldo",
  "type": "module",
  "version": "0.8.0",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "description": "Soldo: everyday expenses, local-first and offline.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "icons": "node scripts/build-icons.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@volverjs/style": "^0.1.32",
    "@volverjs/ui-vue": "^0.0.26",
    "@vueuse/core": "^15.0.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@iconify-json/ph": "^1.2.2",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.157.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
